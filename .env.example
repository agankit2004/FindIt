# Copy to .env and edit. Never commit .env.

SECRET_KEY=change-this-to-something-long-and-random
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Who may register. Leave as-is for IIT Kanpur only.
ALLOWED_EMAIL_DOMAINS=iitk.ac.in

# How long a sign-in code stays valid
OTP_TTL_MINUTES=10

# Leave blank for SQLite. Set for Postgres in production:
# DATABASE_URL=postgres://user:password@host:5432/findit
DATABASE_URL=
